---
import ContactLinks from '../components/ContactLinks.astro';
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
import { loadMenu } from '../lib/sheet';

const { info, horario, excepciones } = await loadMenu();

const DAYS = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
const week = [1, 2, 3, 4, 5, 6, 0].map((dia) => {
  const h = horario.find((x) => x.dia === dia);
  return { dia, nombre: DAYS[dia], horas: h?.abre && h?.cierra ? `${h.abre} – ${h.cierra}` : 'Cerrado' };
});
const today = new Date().toISOString().slice(0, 10);
const upcoming = excepciones.filter((e) => e.fecha >= today).slice(0, 5);
const fmtDate = (ymd: string) => new Intl.DateTimeFormat('es-GT', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' })
  .format(new Date(`${ymd}T12:00:00Z`));
const hours = JSON.stringify({ horario, excepciones });
---
<Base title={`Visítanos · ${info.nombre}`} description={`Horario, dirección y contacto de ${info.nombre}.`} nav="visitanos">
  <Header variant="brand" />
  <div class="intro">
    <h1 class="t-title">Visítanos</h1>
    <p class="sub">Te esperamos con el café del día</p>
  </div>

  <div class="status" data-open-status data-hours={hours}>
    <span class="dot" aria-hidden="true" />
    <span data-open-label>Consulta nuestro horario</span>
  </div>

  <section class="card" aria-labelledby="lbl-hours">
    <h2 class="t-sub" id="lbl-hours"><span class="ms" aria-hidden="true">schedule</span>Horario</h2>
    <ul class="week">
      {week.map((d) => (
        <li data-day={d.dia}><span>{d.nombre}</span><span class="h">{d.horas}</span></li>
      ))}
    </ul>
  </section>

  {upcoming.length > 0 && (
    <section class="card" aria-labelledby="lbl-special">
      <h2 class="t-sub" id="lbl-special">Próximos días especiales</h2>
      <ul class="week special">
        {upcoming.map((e) => (
          <li>
            <span><span class="cap">{fmtDate(e.fecha)}</span>{e.nota && <span class="note">{e.nota}</span>}</span>
            <span class="h">{e.abre && e.cierra ? `${e.abre} – ${e.cierra}` : 'Cerrado'}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(info.direccion || info.mapsUrl) && (
    <section class="card" aria-labelledby="lbl-where">
      <h2 class="t-sub" id="lbl-where"><span class="ms" aria-hidden="true">location_on</span>Dónde estamos</h2>
      {info.direccion && <p class="addr">{info.direccion}</p>}
      {info.mapsUrl && (
        <a href={info.mapsUrl} target="_blank" rel="noopener" class="cta">
          Cómo llegar<span class="ic" aria-hidden="true"><span class="ms">directions</span></span>
        </a>
      )}
    </section>
  )}

  <div class="contact"><ContactLinks info={info} /></div>
</Base>

<script>
  import '../scripts/open-status';
</script>

<style>
  .intro { padding: 8px 24px 0; display: flex; flex-direction: column; gap: 4px; }
  .intro h1 { margin: 0; }
  .sub { margin: 0; font-size: 13px; color: var(--gris-calido); }
  .status {
    margin: 20px 24px 0; padding: 18px 20px; border-radius: 24px; background: var(--espresso); color: var(--crema);
    display: flex; align-items: center; gap: 12px; font-size: 18px; font-weight: 700; letter-spacing: -.01em;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--durazno); flex: none; }
  .status[data-open='true'] .dot { background: #9BD4A6; box-shadow: 0 0 0 4px rgba(155, 212, 166, .2); }
  .card { margin: 14px 24px 0; padding: 18px 20px; border-radius: 24px; background: #fff; box-shadow: 0 0 0 1px var(--linea); }
  .card h2 { margin: 0 0 10px; display: flex; align-items: center; gap: 8px; }
  .card h2 .ms { font-size: 20px; color: var(--terracota-oscuro); }
  .week { list-style: none; margin: 0; padding: 0; }
  .week li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; font-size: 14px; border-bottom: 1px solid var(--linea); }
  .week li:last-child { border-bottom: 0; }
  .week li.today { font-weight: 700; color: var(--terracota-oscuro); }
  .h { color: var(--gris-calido); white-space: nowrap; }
  .today .h { color: inherit; }
  .special li > span:first-child { display: flex; flex-direction: column; }
  .cap::first-letter { text-transform: uppercase; }
  .note { font-size: 12px; color: var(--gris-calido); }
  .addr { margin: 0 0 14px; font-size: 14px; line-height: 20px; }
  .cta {
    height: 56px; padding: 0 9px 0 24px; border-radius: 999px; background: var(--espresso); color: #fff;
    font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    display: flex; align-items: center; justify-content: space-between;
  }
  .ic { width: 38px; height: 38px; border-radius: 50%; background: var(--terracota); display: flex; align-items: center; justify-content: center; }
  .ic .ms { font-size: 20px; }
  .contact { margin: 14px 24px 0; }
</style>
