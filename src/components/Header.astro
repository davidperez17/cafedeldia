---
interface Props {
  variant: 'brand' | 'back';
  backHref?: string;
  backLabel?: string;
  title?: string;
  /** Precio inicial del detalle; el script lo actualiza vía [data-price]. */
  priceLabel?: string;
}

const { variant, backHref = '/', backLabel = 'Volver al menú', title, priceLabel } = Astro.props;
---
{variant === 'brand' ? (
  <header class="brand" data-brand-header>
    <span class="dot" aria-hidden="true" />
    <span>Café del Día</span>
  </header>
) : (
  <header class="back">
    <a href={backHref} class="btn" aria-label={backLabel}><span class="ms" aria-hidden="true">arrow_back</span></a>
    {title && <span class="title">{title}</span>}
    {priceLabel ? (
      <span class="price">
        <span class="plbl">Precio</span>
        <span class="pval" data-price>{priceLabel}</span>
      </span>
    ) : <span class="spacer" />}
  </header>
)}

<style>
  .brand {
    height: 56px; display: flex; align-items: center; justify-content: center; gap: 6px;
    font-size: 17px; font-weight: 800; letter-spacing: -.02em;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--terracota); }
  .back {
    padding: 16px 24px 0; display: flex; justify-content: space-between; align-items: center;
    position: relative; z-index: 2; gap: 12px;
  }
  .btn {
    width: 44px; height: 44px; border-radius: 50%; background: #fff; flex: none;
    box-shadow: 0 4px 12px rgba(43, 29, 20, .08);
    display: flex; align-items: center; justify-content: center;
  }
  .btn .ms { font-size: 22px; }
  .title { font-size: 13px; font-weight: 600; color: var(--gris-calido); text-align: center; }
  .spacer { width: 44px; flex: none; }
  .price { display: flex; flex-direction: column; align-items: flex-end; }
  .plbl { font-size: 11px; color: var(--gris-calido); font-weight: 500; }
  .pval { font-size: 32px; font-weight: 800; letter-spacing: -.03em; line-height: 34px; color: var(--terracota); }
</style>
