---
import type { Badge } from '../../shared/rules.js';

interface Props { kind: Badge; size?: 'sm' | 'md' }

const { kind, size = 'md' } = Astro.props;
const label = kind === 'especialidad' ? (size === 'md' ? 'Especialidad de la casa' : 'Especialidad')
  : kind === 'nuevo' ? 'Nuevo' : 'Agotado';
---
<span class:list={['badge', kind, size]}>
  {kind === 'especialidad' && <span class="ms star" aria-hidden="true">star</span>}
  {label}
</span>

<style>
  .badge {
    display: inline-flex; align-items: center; gap: 4px; align-self: flex-start;
    border-radius: 999px; font-weight: 600; white-space: nowrap;
  }
  .md { height: 24px; padding: 0 10px; font-size: 11px; }
  .sm { height: 22px; padding: 0 10px; font-size: 10px; gap: 3px; }
  .especialidad { background: var(--cafe); color: var(--crema); }
  .nuevo { background: var(--terracota); color: #fff; }
  .agotado { background: #fff; color: var(--gris-calido); border: 1px solid #D9D1C7; }
  .star { color: var(--durazno); font-size: 13px; }
  .sm .star { font-size: 12px; }
</style>
