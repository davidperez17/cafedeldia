---
interface Props {
  summary?: string;
  price?: string;
  mapsUrl?: string;
}

const { summary, price, mapsUrl } = Astro.props;
---
<div class="bar">
  {(summary || price) && (
    <div class="sum" aria-live="polite">
      {summary && <span class="s" data-summary>{summary}</span>}
      {price && <span class="p" data-price>{price}</span>}
    </div>
  )}
  {mapsUrl && (
    <a href={mapsUrl} target="_blank" rel="noopener" class="cta">
      Cómo llegar<span class="ic" aria-hidden="true"><span class="ms">directions</span></span>
    </a>
  )}
</div>

<style>
  .bar {
    position: fixed; z-index: 20; bottom: 0;
    left: max(0px, calc(50% - 240px)); right: max(0px, calc(50% - 240px));
    padding: 28px 24px calc(30px + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, rgba(250, 247, 242, 0) 0%, var(--crema) 30%);
    display: flex; align-items: center; gap: 12px;
  }
  .sum {
    height: 56px; border-radius: 999px; background: var(--niebla); padding: 0 20px;
    display: flex; flex-direction: column; justify-content: center; flex: none; min-width: 0;
  }
  .s { font-size: 11px; color: var(--gris-calido); font-weight: 500; white-space: nowrap; }
  .p { font-size: 18px; font-weight: 800; letter-spacing: -.02em; line-height: 22px; }
  .cta {
    flex: 1; min-width: 0; height: 56px; padding: 0 9px 0 24px; border-radius: 999px;
    background: var(--espresso); color: #fff; box-shadow: 0 12px 24px rgba(23, 17, 13, .25);
    font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    display: flex; align-items: center; justify-content: space-between; white-space: nowrap;
    transition: transform .15s;
  }
  .cta:active { transform: scale(.98); }
  .ic {
    width: 38px; height: 38px; border-radius: 50%; background: var(--terracota);
    display: flex; align-items: center; justify-content: center;
  }
  .ic .ms { font-size: 20px; }
</style>
