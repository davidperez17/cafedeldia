---
import type { Method } from '../../shared/rules.js';
import ProductImage from './ProductImage.astro';

interface Props { method: Method }

const { method: m } = Astro.props;
const segs = (n: number) => [1, 2, 3, 4, 5].map((i) => i <= n);
---
<a href={`/metodos/${m.slug}`} class="card">
  <span class="img"><ProductImage folder="metodos" file={m.imagen} alt={m.nombre} width={124} /></span>
  <span class="name">{m.nombre}</span>
  {m.tiempo && <span class="time"><span class="ms" aria-hidden="true">timer</span>{m.tiempo}</span>}
  <span class="scales">
    {[['Cuerpo', m.cuerpo], ['Acidez', m.acidez]].map(([label, n]) => (
      <span class="scale" role="img" aria-label={`${label}: ${n} de 5`}>
        <span class="lbl">{label}</span>
        <span class="bar">{segs(n as number).map((on) => <span class={on ? 'seg on' : 'seg'} />)}</span>
      </span>
    ))}
  </span>
</a>

<style>
  .card {
    position: relative; margin-top: 60px; background: var(--niebla); border-radius: 24px;
    padding: 80px 14px 16px; display: flex; flex-direction: column; gap: 4px;
    transition: transform .15s;
  }
  .card:active { transform: scale(.98); }
  .img { position: absolute; top: -52px; left: 50%; transform: translateX(-50%); width: 124px; height: 124px; display: block; }
  .name { font-size: 16px; font-weight: 600; line-height: 21px; }
  .time { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--gris-calido); }
  .time .ms { font-size: 14px; }
  .scales { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
  .scale { display: grid; grid-template-columns: 44px 1fr; align-items: center; gap: 6px; }
  .lbl { font-size: 10px; color: var(--gris-calido); }
  .bar { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; }
  .seg { height: 5px; border-radius: 3px; background: var(--segmento-off); }
  .seg.on { background: var(--terracota); }
</style>
