---
import type { Product } from '../../shared/rules.js';
import { formatQ } from '../lib/price';
import { normalize } from '../lib/search';
import Badge from './Badge.astro';
import ProductImage from './ProductImage.astro';

interface Props { product: Product }

const { product: p } = Astro.props;
const out = p.badge === 'agotado';
---
<a
  href={`/p/${p.slug}`}
  class:list={['card', { out }]}
  style={out ? 'opacity:.6' : undefined}
  data-slug={p.slug}
  data-cat={p.categoria}
  data-search={normalize(`${p.nombre} ${p.nota} ${p.descripcion}`)}
>
  <span class="img"><ProductImage folder="productos" file={p.imagen} alt={p.nombre} width={116} /></span>
  <span class="body">
    {p.badge && p.badge !== 'especialidad' && <Badge kind={p.badge} size="sm" />}
    <span class="name">{p.nombre}</span>
    {p.nota && <span class="note">{p.nota}</span>}
    <span class="price">{formatQ(p.precio)}</span>
  </span>
  <span class="go" aria-hidden="true"><span class="ms">arrow_forward</span></span>
</a>

<style>
  .card {
    position: relative; min-height: 104px; background: var(--niebla); border-radius: 24px;
    padding: 14px 14px 14px 92px; display: flex; align-items: center; gap: 12px;
    transition: transform .15s;
  }
  .card:active { transform: scale(.98); }
  .img { position: absolute; left: -32px; top: -16px; width: 116px; height: 116px; display: block; }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .body :global(.badge) { margin-bottom: 2px; }
  .name { font-size: 16px; font-weight: 600; line-height: 21px; }
  .note { font-size: 12px; line-height: 17px; color: var(--gris-calido); }
  .price { font-size: 16px; font-weight: 700; margin-top: 4px; }
  .go {
    width: 38px; height: 38px; border-radius: 50%; flex: none;
    background: var(--boton-claro); box-shadow: var(--sombra-boton);
    display: flex; align-items: center; justify-content: center; font-size: 20px;
  }
</style>
