---
import type { Product } from '../../shared/rules.js';
import { formatQ } from '../lib/price';
import Badge from './Badge.astro';
import ProductImage from './ProductImage.astro';

interface Props { product: Product; compact?: boolean }

const { product: p, compact = false } = Astro.props;
---
<a href={`/p/${p.slug}`} class:list={['card', { compact, out: p.badge === 'agotado' }]}>
  <span class="img">
    <ProductImage folder="productos" file={p.imagen} alt={p.nombre} width={compact ? 110 : 150} />
  </span>
  {!compact && p.badge && <Badge kind={p.badge} size="sm" />}
  <span class="name">{p.nombre}</span>
  {!compact && p.nota && <span class="note">{p.nota}</span>}
  <span class="price">{formatQ(p.precio)}</span>
</a>

<style>
  .card {
    position: relative; margin-top: 64px; width: 176px; flex: none;
    background: var(--niebla); border-radius: 24px; padding: 96px 16px 16px;
    display: flex; flex-direction: column; gap: 4px; scroll-snap-align: start;
    transition: transform .15s;
  }
  .card:active { transform: scale(.98); }
  .img { position: absolute; top: -64px; left: 50%; transform: translateX(-50%); width: 150px; height: 150px; display: block; }
  .card :global(.badge) { position: relative; z-index: 1; margin-bottom: 4px; }
  .name { font-size: 16px; font-weight: 600; line-height: 21px; }
  .note { font-size: 12px; line-height: 17px; color: var(--gris-calido); }
  .price { font-size: 18px; font-weight: 700; margin-top: 10px; }
  .out { opacity: .6; }

  .compact { margin-top: 48px; width: auto; padding: 64px 14px 14px; gap: 2px; }
  .compact .img { top: -44px; width: 110px; height: 100px; }
  .compact .name { font-size: 14px; line-height: 19px; }
  .compact .price { font-size: 16px; margin-top: 6px; }
</style>
